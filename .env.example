# Copy to .env and adjust. Never commit the real .env.

# --- Security ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
TRUTH_SECRET_KEY=change-me-in-production
TRUTH_DEBUG=false

# --- Database ---
# Inside docker-compose the host is the service name `db`; locally use localhost.
TRUTH_DATABASE_URL=postgresql+psycopg://steward:steward@db:5432/steward
POSTGRES_USER=steward
POSTGRES_PASSWORD=steward
POSTGRES_DB=steward

# --- Embeddings (local, private; Ollama-served nomic-embed-text) ---
# nomic-embed-text is 768-dim with an 8192-token context. num_ctx MUST be set
# explicitly — Ollama otherwise caps it at 2048 and silently truncates.
# Alternate: sentence_transformers (in-process HF; set MODEL to a HF id).
TRUTH_EMBEDDING_PROVIDER=ollama
TRUTH_EMBEDDING_MODEL=nomic-embed-text
TRUTH_EMBEDDING_DIM=768
TRUTH_EMBEDDING_NUM_CTX=8192

# --- LLM (choose per environment; embeddings above stay local either way) ---
# Cheapest/most private cloud story: keep embeddings local on a small CPU box and
# switch ONLY the reasoning LLM to a hosted model in prod (raw text never leaves the
# box — only already-extracted, summarized signal does). Or keep everything local on
# a GPU host. This is a deliberate per-env decision, not a silent default.
#   dev  -> ollama (below)      prod -> often anthropic (bottom)
TRUTH_LLM_PROVIDER=ollama
TRUTH_LLM_MODEL=llama3.1:8b
TRUTH_OLLAMA_BASE_URL=http://ollama:11434

# --- Optional hosted LLM (opt-in; trades some privacy for cheaper hosting) ---
# Set TRUTH_LLM_PROVIDER=anthropic to use these instead of local Ollama.
# TRUTH_ANTHROPIC_API_KEY=
# TRUTH_ANTHROPIC_MODEL=claude-sonnet-5

# --- Deployment (used by Caddy reverse proxy for automatic HTTPS) ---
# Set to your domain in production; leave as :80 for local/no-TLS.
SITE_ADDRESS=:80
